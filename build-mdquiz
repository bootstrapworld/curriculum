#! /usr/bin/env bash

# Make sure distribution/ is up to date, unless the caller (e.g. `make
# deploy`) just did a full build itself and passes --skip-make to avoid
# redoing it.
if [[ " $* " != *" --skip-make "* ]]; then
  make
fi

# index.html for the assessment page,
# which loads the quiz and displays it
indexHTML='<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <div id="root"></div>
    <script type="module">
        import buildQuiz from "./lib.js";
        import quizConfig from "./quiz.json?raw" with {type: "json"};
        buildQuiz('"'"'root'"'"', quizConfig)
    </script>
    <style>
      /* Categorize questions: images default to a fixed small size, filling
         the vertical space text cards spend on paragraph margin so the
         enclosing card stays the same size as a text card; click to toggle
         full size. */
      .categorize .categorize-card p:has(> img),
      .categorize .match-tag p:has(> img) {
        margin: 0;
      }
      .categorize .categorize-card img,
      .categorize .match-tag img {
        width: auto;
        height: 3em;
        object-fit: contain;
        cursor: zoom-in;
        transition: height 0.15s ease;
      }
      .categorize .categorize-card img.mq-enlarged,
      .categorize .match-tag img.mq-enlarged {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 300px;
        cursor: zoom-out;
      }
    </style>
    <script>
      document.addEventListener('"'"'click'"'"', function (e) {
        var card = e.target.closest && e.target.closest('"'"'.categorize .categorize-card, .categorize .match-tag'"'"');
        var img = card && card.querySelector('"'"'img'"'"');
        if (img) img.classList.toggle('"'"'mq-enlarged'"'"');
      });
    </script>
  </body>
</html>'

if [[ " $* " == *" --clean "* ]]; then
  # Unconditional refresh of every quiz's pre-build stub (Vite's input) --
  # a manual reset, not the normal incremental path below, so it always
  # touches everything regardless of what changed. The staleness cache
  # below only tracks authored content (quiz.json/assets), not index.html,
  # so it wouldn't otherwise notice this reset happened -- drop it so the
  # next normal run doesn't skip rebuilding these now-torn-down stubs.
  rm -f distribution/.mdquiz-hashes.json
  MDQUIZ_INDEX_HTML="$indexHTML" node --input-type=module -e '
import { glob } from "glob"
import fs from "fs"

const indexHTML = process.env.MDQUIZ_INDEX_HTML;
const mdquizLib = fs.readFileSync("node_modules/mdquiz/dist/lib.js", "utf8")
  .replace(`["localhost", "127.0.0.1"]`, `["localhost", "127.0.0.1", ""]`);

for (const d of glob.sync("distribution/*/{lessons,courses}/*/assessments/*")) {
  if (fs.existsSync(d + "/quiz.json")) {
    fs.writeFileSync(d + "/index.html", indexHTML);
    fs.writeFileSync(d + "/lib.js", mdquizLib);
  } else {
    console.log(`WARNING: ${d} has no quiz.json -- skipping`);
  }
}
'
  exit 0
fi

echo ➤ Checking jsons

JQ=$(which jq)

if test -n "$JQ"; then
  json_error=
  for jf in distribution/*/{lessons,courses}/*/assessments/*/*.json; do
    cat $jf | $JQ -e >/dev/null 2>&1 && continue
    json_error=1
    echo $jf is invalid JSON!
  done
  if test -n "$json_error"; then
    echo Please fix JSON files first!
    exit 1
  fi
fi

echo ➤ Checking which quizzes changed

outputf=.tmp.build-mdquiz.txt
newhashesf=.tmp.build-mdquiz-hashes.json
cachef=distribution/.mdquiz-hashes.json

MDQUIZ_INDEX_HTML="$indexHTML" MDQUIZ_CACHE_FILE="$cachef" MDQUIZ_NEW_HASHES_FILE="$newhashesf" node --input-type=module -e '
import { glob } from "glob"
import fs from "fs"
import crypto from "crypto"

const indexHTML = process.env.MDQUIZ_INDEX_HTML;
const cacheFile = process.env.MDQUIZ_CACHE_FILE;
const newHashesFile = process.env.MDQUIZ_NEW_HASHES_FILE;

const assessmentDirs = glob.sync("distribution/*/{lessons,courses}/*/assessments/*");
const quizzes = [];
for (const d of assessmentDirs) {
  if (fs.existsSync(d + "/quiz.json")) {
    quizzes.push(d);
  } else {
    console.log(`WARNING: ${d} has no quiz.json -- skipping`);
  }
}

// Content hash of everything under a quiz'"'"'s assessments dir except
// index.html and lib.js: both are build-system-generated (the stub above,
// lib.js copied from node_modules/mdquiz) rather than authored content, so
// neither reflects whether the quiz itself actually changed.
function hashQuiz(dir) {
  const hash = crypto.createHash("sha256");
  (function walk(d) {
    const entries = fs.readdirSync(d, { withFileTypes: true })
      .sort((a, b) => a.name < b.name ? -1 : a.name > b.name ? 1 : 0);
    for (const entry of entries) {
      if (entry.name === "index.html" || entry.name === "lib.js") continue;
      const p = d + "/" + entry.name;
      if (entry.isDirectory()) { walk(p); continue; }
      hash.update(p);
      hash.update(fs.readFileSync(p));
    }
  })(dir);
  return hash.digest("hex");
}

let oldHashes = {};
try { oldHashes = JSON.parse(fs.readFileSync(cacheFile, "utf-8")); } catch {}

const newHashes = {};
const staleQuizzes = [];
for (const q of quizzes) {
  const h = hashQuiz(q);
  newHashes[q] = h;
  if (oldHashes[q] !== h) staleQuizzes.push(q);
}

// Written before attempting anything below, so a build failure never loses
// this run'"'"'s hashes -- the outer shell script only promotes this file to
// the real cache once it confirms the build actually succeeded.
fs.writeFileSync(newHashesFile, JSON.stringify(newHashes));

if (staleQuizzes.length === 0) {
  console.log(`No quiz content changed (${quizzes.length} checked) -- skipping quiz build`);
} else {
  console.log(`Building ${staleQuizzes.length} of ${quizzes.length} quiz(zes) (content changed)`);

  // Only the quizzes actually being rebuilt get a fresh stub -- an unstale
  // quiz keeps its already-built (bundled, self-contained) index.html
  // exactly as it was; overwriting it with the raw pre-build stub here
  // would break it until it next happened to be rebuilt.
  const mdquizLib = fs.readFileSync("node_modules/mdquiz/dist/lib.js", "utf8")
    .replace(`["localhost", "127.0.0.1"]`, `["localhost", "127.0.0.1", ""]`);
  for (const q of staleQuizzes) {
    fs.writeFileSync(q + "/index.html", indexHTML);
    fs.writeFileSync(q + "/lib.js", mdquizLib);
  }

  // Deferred to a dynamic import so an all-skip run never pays for loading
  // Vite'"'"'s module graph at all.
  const [{ default: react }, { build }, { viteSingleFile }] = await Promise.all([
    import("@vitejs/plugin-react"),
    import("vite"),
    import("vite-plugin-singlefile"),
  ]);

  const buildConfigs = staleQuizzes.map( quiz => ({
    plugins: [
      react(),
      viteSingleFile(),
    ],
    build: {
      logLevel: "silent",
      root: "distribution",
      minify: false,
      outDir: "./",
      emptyOutDir: false,
      onConsoleLog(log) {
        return "@"+log
      },
      rollupOptions: {
        input: quiz+"/index.html",
      }
    }
  }));

  // wait until all of the builds are complete
  await Promise.all(buildConfigs.map( async c => await build(c)));
}

for (const filePath of quizzes) {
    const fileContent = fs.readFileSync(filePath + "/quiz.json", "utf-8");
    try {
      JSON.parse(fileContent);
      } catch (e) {
        console.error("The quiz.json file inside", filePath, "is not valid JSON!");
      }
}
' > $outputf 2>&1

RED='\033[0;31m'
NC='\033[0m' # No Color

phrase="✗ Build failed"

if ! grep "$phrase" $outputf; then
  cat $outputf
  test -f "$newhashesf" && mv "$newhashesf" "$cachef"
else
  n=$(grep -n "$phrase" $outputf|head -1|cut -d: -f1)
  n=$((n + 1))
  echo ${RED}✗ Build failed${NC}
  tail -n +$n $outputf
  rm -f "$newhashesf"
  exit 1
fi
