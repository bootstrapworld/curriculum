#! /usr/bin/env bash

# Make sure distribution/ is up to date, unless the caller (e.g. `make
# deploy`) just did a full build itself and passes --skip-make to avoid
# redoing it.
if [[ " $* " != *" --skip-make "* ]]; then
  make
fi

# index.html for the assessment page,
# which loads the quiz and displays it
indexHTML='<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>
  <body>
    <div id="root"></div>
    <script type="module">
        import buildQuiz from "./lib.js";
        import quizConfig from "./quiz.json?raw" with {type: "json"};
        buildQuiz('"'"'root'"'"', quizConfig)
    </script>
    <style>
      /* Categorize questions: images default to a fixed small size, filling
         the vertical space text cards spend on paragraph margin so the
         enclosing card stays the same size as a text card; click to toggle
         full size. */
      .categorize .categorize-card p:has(> img),
      .categorize .match-tag p:has(> img) {
        margin: 0;
      }
      .categorize .categorize-card img,
      .categorize .match-tag img {
        width: auto;
        height: 3em;
        object-fit: contain;
        cursor: zoom-in;
        transition: height 0.15s ease;
      }
      .categorize .categorize-card img.mq-enlarged,
      .categorize .match-tag img.mq-enlarged {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 300px;
        cursor: zoom-out;
      }
    </style>
    <script>
      document.addEventListener('"'"'click'"'"', function (e) {
        var card = e.target.closest && e.target.closest('"'"'.categorize .categorize-card, .categorize .match-tag'"'"');
        var img = card && card.querySelector('"'"'img'"'"');
        if (img) img.classList.toggle('"'"'mq-enlarged'"'"');
      });
    </script>
  </body>
</html>'

# Given a list of assessment directories, replace
# the index.html file with a fresh one and
# add the mdquiz JS file
for d in $(find distribution -type d -name assessments); do
  for dd in $d/*; do
    if test -d $dd; then
      if test -f $dd/quiz.json; then
        echo "$indexHTML" > $dd/index.html
        node -e "const fs=require('fs'),f='$dd/lib.js'; \
          fs.writeFileSync(f,fs.readFileSync('node_modules/mdquiz/dist/lib.js','utf8') \
          .replace('[\"localhost\", \"127.0.0.1\"]','[\"localhost\", \"127.0.0.1\", \"\"]'));"
      else
        echo "WARNING: $dd has no quiz.json -- skipping"
      fi
    fi
  done
done

 if [[ " $* " == *" --clean "* ]]; then
   exit 0
 fi

echo ➤ Checking jsons

JQ=$(which jq)

if test -n "$JQ"; then
  json_error=
  for jf in distribution/*/{lessons,courses}/*/assessments/*/*.json; do
    cat $jf | $JQ -e >/dev/null 2>&1 && continue
    json_error=1
    echo $jf is invalid JSON!
  done
  if test -n "$json_error"; then
    echo Please fix JSON files first!
    exit 1
  fi
fi

echo ➤ Building quizzes

outputf=.tmp.build-mdquiz.txt

node --input-type=module -e '
import react from "@vitejs/plugin-react"
import { defineConfig, build } from "vite"
import { viteSingleFile } from "vite-plugin-singlefile"
import { viteStaticCopy } from "vite-plugin-static-copy"
import { glob } from "glob"
import { readFileSync} from "fs"

const quizzes = glob.sync("distribution/*/{lessons,courses}/*/assessments/*").filter(d => {
  try { readFileSync(d + "/quiz.json"); return true; } catch { return false; }
});
const imageTypes = ["svg", "gif", "jpg", "png", "svg"];

// create the JSON objects for each of our quizzes
const buildConfigs = quizzes.map( quiz => ({
  plugins: [
    react(),
    viteSingleFile(),
  ],
  build: {
    logLevel: "silent",
    root: "distribution",
    minify: false,
    outDir: "./",
    emptyOutDir: false,
    onConsoleLog(log) {
      return "@"+log
    },
    rollupOptions: {
      input: quiz+"/index.html",
    }
  }
}));

//console.log(JSON.stringify(buildConfigs, null, 2))

// wait until all of the builds are complete
await Promise.all(buildConfigs.map( async c => await build(c)));

for (const filePath of quizzes) {
    const fileContent = fs.readFileSync(filePath + "/quiz.json", "utf-8");
    try {
      JSON.parse(fileContent);
      } catch (e) {
        console.error("The quiz.json file inside", filePath, "is not valid JSON!");
      }
}
' > $outputf 2>&1

RED='\033[0;31m'
NC='\033[0m' # No Color

phrase="✗ Build failed"

if ! grep "$phrase" $outputf; then
  echo All quizzes were built successfully!
else
  n=$(grep -n "$phrase" $outputf|head -1|cut -d: -f1)
  n=$((n + 1))
  echo ${RED}✗ Build failed${NC}
  tail -n +$n $outputf
fi
