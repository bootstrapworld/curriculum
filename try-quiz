#! /usr/bin/env bash

# Usage: try-quiz [--nomake] [--proglang wescheme|codap] <lesson>
#
# Builds (unless --nomake) a single lesson's quizzes, shows a menu of
# whichever assessments live under that lesson, and launches a local
# server for the one the author picks -- so they can preview it in a
# browser without knowing the distribution folder layout, needing to
# `cd` anywhere themselves, or hand-rolling a `python -m http.server`
# invocation (whose --directory flag isn't even available before
# Python 3.7).

SED=sed

if which gsed|grep -q .; then
  SED=gsed
fi

export PROGLANG
nomake=
lsn=

if test $# -eq 0; then
  echo $0 needs a lesson argument
  exit 1
fi

while test $# -ne 0; do
  if test "$1" = --proglang; then
    shift; PROGLANG="$1"; shift
  elif test "$1" = --nomake; then
    nomake=1; shift
  else
    lsn="$1"; shift
  fi
done

# get at the lesson basename
lsn=${lsn%/}
lsn=${lsn##*/}

if test "$PROGLANG" = wescheme; then
  lsn=$(echo $lsn|$SED -e 's/-wescheme$//')
  lsn=$lsn-wescheme
elif test "$PROGLANG" = codap; then
  lsn=$(echo $lsn|$SED -e 's/-codap$//')
  lsn=$lsn-codap
fi

if echo $lsn|grep -q "\-wescheme$"; then
  PROGLANG=wescheme
elif echo $lsn|grep -q "\-codap$"; then
  PROGLANG=codap
fi

if test -z "$PROGLANG"; then
  PROGLANG=pyret
fi

export TOPDIR=$(pwd)
export NATLANG=${NATLANG:-en-us}

if test -z "$nomake"; then
  ./build-mdquiz
fi

if test ! -d distribution; then
  echo WARNING: Did not find any built pathways
  exit 1
fi

# a lesson's quizzes can live under lessons/, courses/, or (per #2559)
# pathways/ -- rather than assume one, just find wherever this one is
lesson_dir=$(find distribution/$NATLANG -maxdepth 2 -type d -name "$lsn" 2>/dev/null | head -1)

if test -z "$lesson_dir"; then
  echo Lesson $NATLANG/$lsn not found in distribution
  exit 1
fi

assessments_dir="$lesson_dir/assessments"

if test ! -d "$assessments_dir"; then
  echo Lesson $lsn has no assessments -- does it have any quizzes?
  exit 1
fi

JQ=$(which jq)

quiz_dirs=()
quiz_labels=()
for d in "$assessments_dir"/*; do
  if test -f "$d/quiz.json" -a -f "$d/index.html"; then
    title=$(basename "$d")
    if test -n "$JQ"; then
      jq_title=$($JQ -r '.title // empty' "$d/quiz.json" 2>/dev/null)
      test -n "$jq_title" && title="$jq_title ($(basename "$d"))"
    fi
    quiz_dirs+=("$d")
    quiz_labels+=("$title")
  fi
done

if test ${#quiz_dirs[@]} -eq 0; then
  echo Lesson $lsn has an assessments/ folder, but no built quizzes in it -- try dropping --nomake
  exit 1
fi

echo
echo Which quiz would you like to try?
echo
PS3="> "
select label in "${quiz_labels[@]}"; do
  if test -n "$label"; then
    quiz_dir="${quiz_dirs[$((REPLY - 1))]}"
    break
  fi
  echo "Please pick a number between 1 and ${#quiz_labels[@]}."
done

PORT=${PORT:-8000}
url="http://127.0.0.1:$PORT"

echo
echo Launching $label at $url ...
echo "(Ctrl-C to stop the server when you're done.)"
echo

(which open|grep -q .) && (sleep 1; open "$url") &

cd "$quiz_dir" && python3 - "$PORT" <<'PYEOF'
# A plain `python3 -m http.server` calls socket.getfqdn() twice over --
# once in HTTPServer.server_bind() at startup, and again in
# BaseHTTPRequestHandler.address_string() on every single request, purely
# to resolve a hostname for logging. On machines where reverse-DNS/mDNS
# lookups are slow (or just hanging), that turns both server startup and
# every file the quiz loads into a multi-second-or-worse stall. Neither
# lookup is needed to serve files over plain IP, so this skips both.
import sys, http.server, socketserver

PORT = int(sys.argv[1])
HOST = "127.0.0.1"

class FastRequestHandler(http.server.SimpleHTTPRequestHandler):
    def address_string(self):
        return self.client_address[0]

class FastHTTPServer(http.server.HTTPServer):
    def server_bind(self):
        socketserver.TCPServer.server_bind(self)
        self.server_name = self.server_address[0]
        self.server_port = self.server_address[1]

with FastHTTPServer((HOST, PORT), FastRequestHandler) as httpd:
    print("Serving HTTP on {} port {} (http://{}:{}/) ...".format(HOST, PORT, HOST, PORT))
    httpd.serve_forever()
PYEOF
